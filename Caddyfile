# SITE_ADDRESS controls TLS:
#   unset            -> ":80", plain HTTP (fine for an IP-only / pre-domain setup)
#   yimby.example.com -> automatic HTTPS via Let's Encrypt, HTTP redirects to HTTPS
{$SITE_ADDRESS::80} {
	encode gzip

	# JSON access log, read by scripts/caddy_stats.py on the host for latency
	# percentiles and error rates. Rolled at 10 MiB, 5 kept (~50 MiB worst case).
	# 0644 so the script can read it without sudo; Caddy redacts Authorization
	# and Cookie headers by default.
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
			mode 0644
		}
		format json
	}

	root * /usr/share/caddy

	request_body {
		max_size 50MB
	}

	# Reachable from outside for uptime checks / an ALB.
	handle /health {
		reverse_proxy backend:3000
	}

	handle /api/* {
		reverse_proxy backend:3000
	}

	# Hashed build assets — safe to cache forever.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	header /index.html Cache-Control "no-cache"

	# React SPA: serve index.html for any client-side route.
	handle {
		try_files {path} /index.html
		file_server
	}
}

# GoatCounter: the dashboard, plus /count and /count.js that the site's
# tracking script calls. Needs its own DNS record pointing at this instance.
{$STATS_ADDRESS:stats.yimby-tracker.fyi} {
	encode gzip
	reverse_proxy goatcounter:8080
}
